---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import Star from '../brand/Star.astro';
import CheckerPattern from '../brand/CheckerPattern.astro';

interface Props {
  poster?: ImageMetadata;
}

const { poster } = Astro.props;
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero__stage">
    {poster && (
      <Image
        src={poster}
        alt=""
        widths={[640, 960, 1440]}
        sizes="100vw"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="hero__poster"
      />
    )}
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__grid" aria-hidden="true"></div>
    <Container class="hero__inner">
      <div class="hero__content">
        <h1 id="hero-title" class="hero__title">
          <span class="hero__title-first">Видео&shy;трансляции</span>
          <span class="hero__title-second">
            под <span>ключ</span>
          </span>
        </h1>
        <p class="hero__description">
          Для государства и бизнеса.
          <br />
          Ваше событие — в прямом эфире.
        </p>
        <div class="hero__actions">
          <ButtonLink href="#contacts">Обсудить проект</ButtonLink>
          <ButtonLink href="#cases" variant="secondary" arrow={false}>
            Смотреть кейсы
          </ButtonLink>
        </div>
      </div>
      <div class="hero__decor hero__decor--large">
        <Star size={146} />
      </div>
      <div class="hero__decor hero__decor--small">
        <Star size={74} color="violet" />
      </div>
      <div class="hero__bottomline">
        <p class="hero__signature eyebrow">Событие. Люди. Эфир.</p>
        <a href="#services" class="hero__explore">
          Откройте возможности
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path d="M10 3v14m-5-5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </a>
      </div>
    </Container>
  </div>
  <CheckerPattern class="hero__checker" />
</section>

<style>
  .hero {
    --hero-divider-height: 1.5rem;
    position: relative;
    isolation: isolate;
    scroll-margin-top: 0;
  }

  .hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--color-bg);
  }

  .hero :global(.hero__poster),
  .hero__shade,
  .hero__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero :global(.hero__poster) {
    z-index: -3;
    object-fit: cover;
    object-position: 54% center;
    filter: grayscale(1);
  }

  .hero__shade {
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-bg) 82%, transparent),
        color-mix(in srgb, var(--color-bg) 35%, transparent)
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg) 20%, transparent) 10%,
        color-mix(in srgb, var(--color-bg) 15%, transparent) 55%,
        var(--color-bg)
      );
  }

  .hero__grid {
    z-index: -1;
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-text) 8%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-text) 8%, transparent) 1px,
        transparent 1px
      );
    background-size:
      25% 100%,
      100% 25%;
    mask-image: linear-gradient(110deg, transparent 10%, black);
  }

  .hero :global(.hero__inner) {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: clamp(
      30rem,
      calc(100svh - var(--header-height) - var(--hero-divider-height)),
      48rem
    );
    padding-block: 0 var(--space-4);
  }

  .hero__bottomline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    align-self: center;
    padding-block: clamp(1.5rem, 5svh, 3.5rem);
  }

  .hero__title {
    font-size: clamp(1.875rem, 5.75vw, 4.5rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.052em;
    text-transform: uppercase;
    text-wrap: initial;
    overflow-wrap: normal;
    hyphens: manual;
  }

  .hero__title-first,
  .hero__title-second {
    display: block;
  }

  .hero__title-second {
    margin-top: var(--space-1);
  }

  .hero__title-second > span {
    color: var(--color-violet-text);
  }

  .hero__description {
    max-width: 36rem;
    margin-top: var(--space-5);
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.375rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
    max-width: 25rem;
    margin-top: var(--space-5);
  }

  .hero__actions :global(.button-link--secondary) {
    background: color-mix(in srgb, var(--color-bg) 40%, transparent);
  }

  .hero__decor {
    position: absolute;
    pointer-events: none;
  }

  .hero__decor :global(svg) {
    width: 100%;
    height: auto;
  }

  .hero__decor--large {
    top: var(--space-4);
    right: 0;
    width: 2rem;
    transform: rotate(12deg);
  }

  .hero__decor--small {
    display: none;
  }

  .hero__bottomline {
    position: relative;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .hero__signature {
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .hero__explore {
    display: none;
    align-items: center;
    gap: var(--space-5);
    min-height: 2.75rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .hero :global(.hero__checker) {
    --checker-size: calc(var(--hero-divider-height) / 2);
    height: var(--hero-divider-height);
  }

  @media (min-width: 48rem) {
    .hero {
      --hero-divider-height: 2rem;
    }

    .hero__title {
      font-size: clamp(2.5rem, min(5.3vw, 8svh), 4.5rem);
    }

    .hero__actions {
      flex-direction: row;
      gap: var(--space-4);
      max-width: none;
      margin-top: clamp(1.5rem, 4svh, 2.5rem);
    }

    .hero__decor--large {
      top: var(--space-5);
      right: 0;
      width: 3rem;
    }

    .hero__decor--small {
      display: block;
      bottom: 7rem;
      right: 9%;
      width: 3.5rem;
      transform: rotate(-8deg);
    }

    .hero__signature {
      font-size: var(--text-xs);
    }

    .hero__explore {
      display: flex;
    }
  }

  @media (min-width: 80rem) {
    .hero__decor--large {
      top: 22%;
      width: clamp(6rem, 12svh, 8rem);
    }

    .hero__decor--small {
      bottom: 7rem;
      right: 27%;
    }
  }
</style>
