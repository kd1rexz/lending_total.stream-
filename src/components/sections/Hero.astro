---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import ProjectCTA from '../ui/ProjectCTA.astro';
import Star from '../brand/Star.astro';

interface Props {
  poster?: ImageMetadata;
}

const { poster } = Astro.props;
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero__stage">
    {poster && (
      <Image
        src={poster}
        alt=""
        widths={[640, 960, 1440]}
        sizes="100vw"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="hero__poster"
      />
    )}
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__lines" aria-hidden="true">
      <svg
        class="hero__lines-wide"
        viewBox="0 0 1920 1080"
        preserveAspectRatio="none"
        focusable="false"
      >
        <g class="hero__lines-soft">
          <path d="M760 136V1080M952 0V1080M1054 0V1080M1636 0V1080" />
          <path d="M0 316H1920M0 550H1920" />
        </g>
        <path d="M0 714H518C580 714 610 744 610 806V1080" />
        <path d="M0 974H740C805 974 842 937 842 872V228C842 175 865 144 910 119L1030 51C1062 33 1080 14 1094 0" />
        <path d="M658 1080V238C658 173 695 136 760 136H1410C1492 136 1544 101 1606 0" />
        <path d="M1920 702H1500C1410 702 1360 752 1360 842V1080" />
        <path d="M1920 432H1332C1268 432 1232 468 1232 532V1080" />
      </svg>
      <svg
        class="hero__lines-narrow"
        viewBox="0 0 390 780"
        preserveAspectRatio="none"
        focusable="false"
      >
        <path d="M290 0V108C290 148 314 172 354 172H390" />
        <path d="M390 574H310C264 574 240 598 240 644V780" />
        <path class="hero__lines-soft" d="M342 0V780M0 686H390" />
      </svg>
    </div>
    <Container class="hero__inner">
      <div class="hero__content">
        <h1 id="hero-title" class="hero__title">
          <span class="hero__title-first">Видео&shy;трансляции</span>
          <span class="hero__title-second">
            под <span>ключ</span>
          </span>
        </h1>
        <p class="hero__description">
          Для государства и бизнеса.
          <br />
          Ваше событие — в прямом эфире.
        </p>
        <div class="hero__actions">
          <ProjectCTA />
        </div>
        <div class="hero__decor hero__decor--large">
          <Star size={146} color="violet" />
        </div>
        <div class="hero__decor hero__decor--small">
          <Star size={40} color="violet" />
        </div>
      </div>
      <div class="hero__bottomline">
        <a href="#services" class="hero__explore">
          <span class="hero__scroll-track" aria-hidden="true"></span>
          <span class="hero__scroll-label">Откройте возможности</span>
        </a>
      </div>
    </Container>
  </div>
</section>

<script>
  import '../../scripts/hero-cue';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    scroll-margin-top: 0;
  }

  .hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--color-bg);
  }

  .hero :global(.hero__poster),
  .hero__shade,
  .hero__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero :global(.hero__poster) {
    z-index: -3;
    object-fit: cover;
    object-position: 54% center;
    filter: grayscale(1);
  }

  .hero__shade {
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-bg) 82%, transparent),
        color-mix(in srgb, var(--color-bg) 35%, transparent)
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg) 20%, transparent) 10%,
        color-mix(in srgb, var(--color-bg) 15%, transparent) 55%,
        var(--color-bg)
      );
  }

  .hero__lines {
    z-index: -1;
    color: var(--color-text);
    opacity: 0.2;
    mask-image: linear-gradient(110deg, rgb(0 0 0 / 25%), black 75%);
  }

  .hero__lines svg {
    width: 100%;
    height: 100%;
    fill: none;
  }

  .hero__lines path {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .hero__lines-soft {
    opacity: 0.35;
  }

  .hero__lines-wide {
    display: none;
  }

  .hero :global(.hero__inner) {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: max(36rem, 100svh);
    padding-block: var(--header-height) var(--space-4);
  }

  .hero__bottomline {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-5);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    align-self: center;
    padding-block: clamp(3rem, 6svh, 4rem);
  }

  .hero__title {
    font-size: clamp(2rem, 8.4vw, 2.5rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.052em;
    text-transform: uppercase;
    text-wrap: initial;
    overflow-wrap: normal;
    hyphens: manual;
  }

  .hero__title-first,
  .hero__title-second {
    display: block;
  }

  .hero__title-second {
    margin-top: var(--space-1);
  }

  .hero__title-second > span {
    color: var(--color-violet-accent);
  }

  .hero__description {
    max-width: 36rem;
    margin-top: var(--space-5);
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.375rem);
    line-height: 1.55;
  }

  .hero__actions {
    margin-top: clamp(2.5rem, 6svh, 4rem);
  }

  .hero__decor {
    position: absolute;
    pointer-events: none;
  }

  .hero__decor :global(svg) {
    width: 100%;
    height: auto;
  }

  .hero__decor--large {
    top: 0;
    right: 0;
    width: 2rem;
    transform: rotate(12deg);
  }

  .hero__decor--small {
    display: none;
  }

  .hero__bottomline {
    position: relative;
    padding-top: var(--space-4);
  }

  .hero__explore {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    color: var(--color-text);
    font-size: var(--text-xs);
    text-decoration: none;
    transition:
      opacity 1100ms cubic-bezier(0.4, 0, 0.2, 1),
      translate 1100ms cubic-bezier(0.4, 0, 0.2, 1),
      visibility 1100ms,
      scale 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hero__explore:active { scale: 0.97; }
  .hero__explore[data-dismissed] {
    opacity: 0;
    translate: 0 var(--cue-exit-distance, 96px);
    visibility: hidden;
    pointer-events: none;
  }
  .hero__explore[data-viewport] {
    position: fixed;
    z-index: 20;
    top: var(--cue-top);
    left: var(--cue-left);
    width: var(--cue-width);
    margin: 0;
    will-change: translate, opacity;
  }
  .hero__explore[data-viewport]:not([data-cue-ready]) {
    transition: none;
  }

  .hero__scroll-track {
    position: relative;
    flex: 0 0 auto;
    width: 1.375rem;
    height: 2.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
  }
  .hero__scroll-track::after {
    content: '';
    position: absolute;
    top: 0.375rem;
    left: calc(50% - 2.5px);
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-lime);
    --scroll-travel: 16px;
    --scroll-opacity: 0.15;
  }
  .hero__scroll-label {
    --scroll-travel: 3px;
  }
  .hero__scroll-track::after,
  .hero__scroll-label {
    animation: scroll-cue 2.8s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  @keyframes scroll-cue {
    0%,
    100% {
      transform: translateY(0);
      opacity: 1;
    }
    50% {
      transform: translateY(var(--scroll-travel));
      opacity: var(--scroll-opacity, 1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__explore:active { scale: 1; }
    .hero__scroll-track::after,
    .hero__scroll-label {
      animation: none;
    }
  }

  @media (min-width: 48rem) {
    .hero__lines-wide {
      display: block;
    }

    .hero__lines-narrow {
      display: none;
    }

    .hero__title {
      font-size: clamp(2.5rem, min(5.3vw, 8svh), 4.5rem);
    }

    .hero__decor--large {
      top: 0;
      right: 0;
      width: 3rem;
    }

    .hero__decor--small {
      display: block;
      bottom: clamp(3rem, 6svh, 4rem);
      right: 8%;
      width: 2rem;
      transform: rotate(-8deg);
    }

    .hero__bottomline {
      display: flex;
    }

    .hero__explore {
      display: flex;
    }
  }

  @media (min-width: 64rem) {
    .hero__decor--large {
      width: 3.25rem;
    }
    .hero__decor--small {
      width: 3rem;
    }
  }

  @media (min-width: 80rem) {
    .hero__decor--large {
      top: clamp(3rem, 6svh, 4rem);
      width: clamp(6.5rem, 13svh, 8.5rem);
    }

    .hero__decor--small {
      width: 3.25rem;
      right: 22%;
    }
  }
</style>
