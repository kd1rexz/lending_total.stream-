---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import Star from '../brand/Star.astro';

interface Props {
  poster?: ImageMetadata;
}

const { poster } = Astro.props;
---

<section id="top" class="hero" aria-labelledby="hero-title">
  <div class="hero__stage">
    {poster && (
      <Image
        src={poster}
        alt=""
        widths={[640, 960, 1440]}
        sizes="100vw"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
        class="hero__poster"
      />
    )}
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="hero__lines" aria-hidden="true">
      <svg
        class="hero__lines-wide"
        viewBox="0 0 1920 1080"
        preserveAspectRatio="none"
        focusable="false"
      >
        <g class="hero__lines-soft">
          <path d="M760 136V1080M952 0V1080M1054 0V1080M1636 0V1080" />
          <path d="M0 316H1920M0 550H1920" />
        </g>
        <path d="M0 714H518C580 714 610 744 610 806V1080" />
        <path d="M0 974H740C805 974 842 937 842 872V228C842 175 865 144 910 119L1030 51C1062 33 1080 14 1094 0" />
        <path d="M658 1080V238C658 173 695 136 760 136H1410C1492 136 1544 101 1606 0" />
        <path d="M1920 702H1500C1410 702 1360 752 1360 842V1080" />
        <path d="M1920 432H1332C1268 432 1232 468 1232 532V1080" />
      </svg>
      <svg
        class="hero__lines-narrow"
        viewBox="0 0 390 780"
        preserveAspectRatio="none"
        focusable="false"
      >
        <path d="M290 0V108C290 148 314 172 354 172H390" />
        <path d="M390 574H310C264 574 240 598 240 644V780" />
        <path class="hero__lines-soft" d="M342 0V780M0 686H390" />
      </svg>
    </div>
    <Container class="hero__inner">
      <div class="hero__content">
        <h1 id="hero-title" class="hero__title">
          <span class="hero__title-first">Видео&shy;трансляции</span>
          <span class="hero__title-second">
            под <span>ключ</span>
          </span>
        </h1>
        <p class="hero__description">
          Для государства и бизнеса.
          <br />
          Ваше событие — в прямом эфире.
        </p>
        <div class="hero__actions">
          <ButtonLink href="#contacts" arrow={false}>
            Обсудить проект
          </ButtonLink>
          <ButtonLink href="#cases" variant="secondary" arrow={false}>
            Смотреть кейсы
          </ButtonLink>
        </div>
        <div class="hero__decor hero__decor--large">
          <Star size={146} />
        </div>
        <div class="hero__decor hero__decor--small">
          <Star size={74} color="violet" />
        </div>
      </div>
      <div class="hero__bottomline">
        <a href="#services" class="hero__explore">
          Откройте возможности
          <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
            <path d="M10 3v14m-5-5 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </a>
      </div>
    </Container>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    scroll-margin-top: 0;
  }

  .hero__stage {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--color-bg);
  }

  .hero :global(.hero__poster),
  .hero__shade,
  .hero__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .hero :global(.hero__poster) {
    z-index: -3;
    object-fit: cover;
    object-position: 54% center;
    filter: grayscale(1);
  }

  .hero__shade {
    z-index: -2;
    background:
      linear-gradient(
        90deg,
        color-mix(in srgb, var(--color-bg) 82%, transparent),
        color-mix(in srgb, var(--color-bg) 35%, transparent)
      ),
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-bg) 20%, transparent) 10%,
        color-mix(in srgb, var(--color-bg) 15%, transparent) 55%,
        var(--color-bg)
      );
  }

  .hero__lines {
    z-index: -1;
    color: var(--color-text);
    opacity: 0.2;
    mask-image: linear-gradient(110deg, rgb(0 0 0 / 25%), black 75%);
  }

  .hero__lines svg {
    width: 100%;
    height: 100%;
    fill: none;
  }

  .hero__lines path {
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .hero__lines-soft {
    opacity: 0.35;
  }

  .hero__lines-wide {
    display: none;
  }

  .hero :global(.hero__inner) {
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto;
    min-height: max(30rem, calc(100svh - var(--header-height)));
    padding-block: 0 var(--space-4);
  }

  .hero__bottomline {
    display: none;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-5);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    align-self: center;
    padding-block: clamp(3rem, 6svh, 4rem);
  }

  .hero__title {
    font-size: clamp(1.875rem, 5.75vw, 4.5rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.052em;
    text-transform: uppercase;
    text-wrap: initial;
    overflow-wrap: normal;
    hyphens: manual;
  }

  .hero__title-first,
  .hero__title-second {
    display: block;
  }

  .hero__title-second {
    margin-top: var(--space-1);
  }

  .hero__title-second > span {
    color: var(--color-violet-text);
  }

  .hero__description {
    max-width: 36rem;
    margin-top: var(--space-5);
    font-size: clamp(1rem, 0.85rem + 0.6vw, 1.375rem);
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-4);
    max-width: 25rem;
    margin-top: clamp(2.5rem, 6svh, 4rem);
  }

  .hero__actions :global(.button-link) {
    min-height: 3.5rem;
    padding: var(--space-4) var(--space-5);
    border-color: transparent;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.025em;
    text-transform: uppercase;
    transition:
      background-color var(--duration-fast) ease,
      box-shadow var(--duration-fast) ease;
  }

  .hero__actions :global(.button-link--primary) {
    box-shadow: 0 0 1.75rem color-mix(in srgb, var(--color-lime) 20%, transparent);
  }

  .hero__actions :global(.button-link--secondary) {
    color: var(--color-bg);
    background: var(--color-text);
    box-shadow: 0 0 1.75rem color-mix(in srgb, var(--color-text) 16%, transparent);
  }

  .hero__actions :global(.button-link:focus-visible) {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    box-shadow: 0 0 0 6px var(--color-bg);
  }

  @media (hover: hover) {
    .hero__actions :global(.button-link--primary:hover) {
      box-shadow: 0 0 2rem color-mix(in srgb, var(--color-lime) 32%, transparent);
    }

    .hero__actions :global(.button-link--secondary:hover) {
      background: var(--color-muted);
      box-shadow: 0 0 2rem color-mix(in srgb, var(--color-text) 24%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__actions :global(.button-link) {
      transition: none;
    }
  }

  .hero__decor {
    position: absolute;
    pointer-events: none;
  }

  .hero__decor :global(svg) {
    width: 100%;
    height: auto;
  }

  .hero__decor--large {
    top: 0;
    right: 0;
    width: 2rem;
    transform: rotate(12deg);
  }

  .hero__decor--small {
    display: none;
  }

  .hero__bottomline {
    position: relative;
    padding-top: var(--space-4);
  }

  .hero__explore {
    display: none;
    align-items: center;
    gap: var(--space-5);
    min-height: 2.75rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  @media (min-width: 48rem) {
    .hero__lines-wide {
      display: block;
    }

    .hero__lines-narrow {
      display: none;
    }

    .hero__title {
      font-size: clamp(2.5rem, min(5.3vw, 8svh), 4.5rem);
    }

    .hero__actions {
      flex-direction: row;
      flex-wrap: wrap;
      max-width: none;
      margin-top: clamp(3rem, 7svh, 4.5rem);
    }

    .hero__actions :global(.button-link) {
      flex: 0 1 16.5rem;
    }

    .hero__decor--large {
      top: 0;
      right: 0;
      width: 3rem;
    }

    .hero__decor--small {
      display: block;
      bottom: clamp(3rem, 6svh, 4rem);
      right: 8%;
      width: 3.5rem;
      transform: rotate(-8deg);
    }

    .hero__bottomline {
      display: flex;
    }

    .hero__explore {
      display: flex;
    }
  }

  @media (min-width: 80rem) {
    .hero__decor--large {
      top: clamp(3rem, 6svh, 4rem);
      width: clamp(6rem, 12svh, 8rem);
    }

    .hero__decor--small {
      right: 22%;
    }
  }
</style>
