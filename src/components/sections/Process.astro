---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { ProcessStep } from '../../types/content';
interface Props {
  items: ProcessStep[];
}
const { items } = Astro.props;
---

<section class="section process" id="process" aria-labelledby="process-title">
  <Container>
    <SectionHeading
      number="03"
      eyebrow="Как работаем"
      title="От первого разговора до финального кадра"
      id="process-title"
    />
    <ol class="process__steps" role="list">
      {items.map((item, index) => (
        <li class="process__step">
          <span class="process__number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="process__copy">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </Container>
</section>

<style>
  .process {
    --color-muted: var(--color-on-violet);
    background: var(--color-violet);
    color: var(--color-on-violet);
  }
  .process__steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-7);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .process__step {
    display: grid;
    grid-template-columns: 3.8rem minmax(0, 1fr);
    align-items: start;
    gap: var(--space-5);
    min-width: 0;
    padding-top: var(--space-5);
    border-top: 1px solid color-mix(in srgb, var(--color-on-violet) 40%, transparent);
  }
  .process__number {
    color: var(--color-lime);
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 2rem + 2vw, 4.75rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.07em;
  }
  .process__copy {
    min-width: 0;
  }
  .process__copy h3 {
    margin-bottom: var(--space-4);
  }
  .process__copy p {
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }
  @media (min-width: 48rem) {
    .process__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-7);
    }
    .process__step {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
    .process__copy p {
      max-width: 34rem;
    }
  }
  @media (min-width: 64rem) {
    .process__steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-6);
    }
    .process__copy h3 {
      font-size: var(--text-sm);
      letter-spacing: -0.025em;
      line-height: 1.45;
    }
  }
</style>
