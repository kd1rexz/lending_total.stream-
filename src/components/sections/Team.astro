---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import type { TeamProfile } from '../../types/content';
interface Props {
  profile: TeamProfile;
}
const { profile } = Astro.props;
---

<section class="section team" id="team" aria-labelledby="team-title">
  <Container>
    <div class="team__layout">
      <div class="team__portrait">
        <Image
          src={profile.portrait}
          alt={profile.name}
          widths={[360, 640, 960]}
          sizes="(min-width: 1280px) 440px, (min-width: 768px) 40vw, 90vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="team__copy">
        <p class="team__eyebrow eyebrow">
          <span aria-hidden="true">/03</span> О команде
        </p>
        <h2 id="team-title">{profile.name}</h2>
        <p class="team__role">{profile.role}</p>
        <p class="team__description">{profile.description}</p>
      </div>
    </div>
  </Container>
</section>

<style>
  .team {
    background: var(--color-violet);
    color: var(--color-on-violet);
  }
  .team__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--space-7);
  }
  .team__portrait {
    width: 100%;
    max-width: 27.5rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  .team__portrait :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .team__copy {
    min-width: 0;
  }
  .team__eyebrow {
    display: flex;
    gap: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .team__eyebrow span {
    color: var(--color-lime);
  }
  .team__copy h2 {
    max-width: 12ch;
    font-size: clamp(2rem, 1.3rem + 3vw, 4rem);
    line-height: 1.15;
  }
  .team__role {
    margin-top: var(--space-5);
    color: var(--color-lime);
    font-size: var(--text-lg);
    overflow-wrap: anywhere;
  }
  .team__description {
    max-width: 34ch;
    margin-top: var(--space-7);
    padding-top: var(--space-6);
    border-top: 1px solid color-mix(in srgb, var(--color-on-violet) 40%, transparent);
    font-size: var(--text-lg);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  @media (min-width: 48rem) {
    .team__layout {
      grid-template-columns: minmax(0, 4fr) minmax(0, 5fr);
      gap: clamp(2rem, 5vw, 6rem);
    }
  }
</style>
