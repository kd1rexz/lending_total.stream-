---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import type { TeamProfile } from '../../types/content';
interface Props {
  profile: TeamProfile;
}
const { profile } = Astro.props;
---

<section class="section team" id="team" aria-labelledby="team-title">
  <Container>
    <div class="team__layout">
      <div class="team__portrait">
        <Image
          src={profile.portrait}
          alt={profile.name}
          widths={[360, 640, 960]}
          sizes="(min-width: 1280px) 440px, (min-width: 768px) 40vw, 90vw"
          format="webp"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="team__copy">
        <h2 id="team-title">{profile.name}</h2>
        <p class="team__role">{profile.role}</p>
        <p class="team__description">{profile.description}</p>
      </div>
    </div>
  </Container>
</section>

<style>
  .team {
    background: var(--color-surface);
    color: var(--color-text);
  }
  .team__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--space-7);
  }
  .team__portrait {
    width: 100%;
    max-width: 25rem;
    aspect-ratio: 4 / 5;
    padding: 7px;
    border: 1px solid color-mix(in srgb, var(--color-violet-accent) 70%, transparent);
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  .team__portrait :global(img) {
    width: 100%;
    height: 100%;
    border-radius: calc(var(--radius-card) - 8px);
    object-fit: cover;
    object-position: 50% 40%;
  }
  .team__copy {
    min-width: 0;
    max-width: 32rem;
  }
  .team__copy h2 {
    max-width: 13ch;
    font-size: clamp(2rem, 1.25rem + 2.5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }
  .team__role {
    margin-top: var(--space-4);
    color: var(--color-violet-text);
    font-size: var(--text-base);
    overflow-wrap: anywhere;
  }
  .team__description {
    max-width: 31ch;
    margin-top: var(--space-7);
    font-size: clamp(1.125rem, 0.95rem + 0.7vw, 1.5rem);
    line-height: 1.65;
    color: var(--color-muted);
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }
  .team__description::before {
    content: "";
    display: block;
    width: 2.5rem;
    height: 3px;
    margin-bottom: var(--space-5);
    border-radius: 2px;
    background: var(--color-violet-accent);
  }
  @media (min-width: 48rem) {
    .team__layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--section-column-gap);
    }
  }
</style>
