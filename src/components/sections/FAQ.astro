---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { FAQItem } from '../../types/content';
interface Props {
  items: FAQItem[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="section faq" aria-labelledby="faq-title">
    <Container>
      <div class="faq__layout">
        <SectionHeading title="До начала эфира" id="faq-title" />
        <div class="faq__items">
          {items.map((item) => (
            <details class="faq__item">
              <summary>
                <span>{item.question}</span>
                <span class="faq__icon" aria-hidden="true"></span>
              </summary>
              <div class="faq__answer">
                <p>{item.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </Container>
  </section>
)}

<script>
  import '../../scripts/faq';
</script>

<style>
  .faq { padding-block: clamp(3.5rem, 6vw, 5rem); }
  .faq__layout {
    display: grid;
    gap: 0;
    max-width: 64rem;
    margin-inline: auto;
  }
  .faq :global(.section-heading) { margin-bottom: 2rem; }
  .faq :global(.section-heading__title) { font-size: clamp(2rem, 3vw, 2.75rem); }
  .faq__items {
    min-width: 0;
    border-top: 1px solid var(--color-border);
  }
  .faq__item {
    border-bottom: 1px solid var(--color-border);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 4.5rem;
    padding-block: 1.25rem;
    list-style: none;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.4;
    transition: color var(--duration-fast) ease;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary > span:first-child {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .faq__icon {
    display: block;
    position: relative;
    flex: 0 0 1.5rem;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-lime);
    transition: transform 460ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    display: block;
    background: currentColor;
    pointer-events: none;
  }
  .faq__icon::before {
    inset: calc(50% - 1px) 0 auto;
    height: 2px;
  }
  .faq__icon::after {
    inset: 0 auto 0 calc(50% - 1px);
    width: 2px;
  }
  .faq__item[open]:not([data-closing]) .faq__icon {
    transform: rotate(45deg);
  }
  .faq__answer {
    max-width: 56rem;
    padding: 0 2.75rem var(--space-6) 0;
    color: var(--color-muted);
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
  }
  .faq__item summary > span:first-child { transition: transform 460ms cubic-bezier(0.4, 0, 0.2, 1); }
  .faq__item[open]:not([data-closing]) summary > span:first-child { transform: translateX(6px); }
  @media (prefers-reduced-motion: reduce) {
    .faq__icon, .faq__item summary > span:first-child { transition: none !important; }
    .faq__item[open] summary > span:first-child { transform: none; }
  }
  @media (hover: hover) {
    .faq__item summary:hover {
      color: var(--color-text);
    }
  }
  @media (max-width: 47.999rem) {
    .faq__item summary { font-size: 1.125rem; gap: 1rem; }
    .faq__icon { width: 1.25rem; height: 1.25rem; flex-basis: 1.25rem; }
    .faq__answer { font-size: 1rem; padding-right: 2rem; }
  }
</style>
