---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Star from '../brand/Star.astro';
import type { Service } from '../../types/content';

interface Props {
  items: Service[];
}
const { items } = Astro.props;
---

<section class="section services" id="services" aria-labelledby="services-title">
  <Container>
    <div class="services__intro">
      <SectionHeading
        number="01"
        eyebrow="Что делаем"
        title="Форматы под вашу задачу"
        id="services-title"
      />
      <div class="services__decoration">
        <Star color="lime" size={76} />
      </div>
    </div>
    <div class="services__list">
      {items.map((service, index) => (
        <article class="service">
          <span class="service__number eyebrow" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="service__heading">
            <p class="service__tag eyebrow">{service.tag}</p>
            <h3>{service.title}</h3>
          </div>
          <div class="service__body">
            <p>{service.description}</p>
            <a
              class="service__link"
              href="#contacts"
              aria-label={`Обсудить услугу: ${service.title}`}
            >
              <span>Обсудить услугу</span>
              <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
                <path
                  d="M5 19 19 5M5 5h14v14"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                />
              </svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  .services__intro {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .services__decoration {
    display: none;
    flex: 0 0 auto;
    padding-top: var(--space-6);
    transform: rotate(12deg);
  }
  .services__list {
    border-top: 1px solid var(--color-border);
  }
  .service {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-5) var(--space-4);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }
  .service__number {
    padding-top: 0.15rem;
    color: var(--color-muted);
  }
  .service__heading,
  .service__body {
    min-width: 0;
  }
  .service__tag {
    margin-bottom: var(--space-4);
    color: var(--color-lime);
    overflow-wrap: anywhere;
  }
  .service__body {
    grid-column: 2;
  }
  .service__body > p {
    max-width: 37rem;
    color: var(--color-muted);
    font-size: var(--text-base);
    overflow-wrap: anywhere;
  }
  .service__link {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 2.75rem;
    margin-top: var(--space-5);
    padding-block: var(--space-2);
    font-size: var(--text-xs);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }
  .service__link > span {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .service__link > svg {
    flex: 0 0 auto;
  }
  @media (hover: hover) {
    .service__link:hover {
      color: var(--color-lime);
    }
  }
  @media (min-width: 48rem) {
    .services__decoration {
      display: block;
    }
    .service {
      grid-template-columns: 3rem minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-6);
      padding-block: var(--space-7);
    }
    .service__body {
      grid-column: auto;
    }
    .service__heading h3 {
      max-width: 20ch;
    }
  }
  @media (min-width: 64rem) {
    .service {
      padding-block: var(--space-7);
      column-gap: var(--space-7);
    }
  }
</style>
