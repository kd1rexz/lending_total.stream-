---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Star from '../brand/Star.astro';
import ServiceExamples from '../ui/ServiceExamples.astro';
import type { ServiceWithExamples } from '../../types/content';

interface Props {
  items: ServiceWithExamples[];
}
const { items } = Astro.props;
---

<section class="section services" id="services" aria-labelledby="services-title">
  <Container>
    <div class="services__intro">
      <SectionHeading
        number="01"
        eyebrow="Что делаем"
        title="Форматы под вашу задачу"
        id="services-title"
      />
      <div class="services__decoration">
        <Star color="lime" size={76} />
      </div>
    </div>
    <div class="services__list">
      {items.map((service, index) => (
        <article class="service">
          <span class="service__number eyebrow" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div class="service__heading">
            <p class="service__tag eyebrow">{service.tag}</p>
            <h3>{service.title}</h3>
          </div>
          <div class="service__body">
            <p>{service.description}</p>
            <ServiceExamples service={service} />
          </div>
        </article>
      ))}
    </div>
  </Container>
</section>

<style>
  .services__intro {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .services__decoration {
    display: none;
    flex: 0 0 auto;
    padding-top: var(--space-6);
    transform: rotate(12deg);
  }
  .services__list {
    border-top: 1px solid var(--color-border);
  }
  .service {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-5) var(--space-4);
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }
  .service__number {
    padding-top: 0.15rem;
    color: var(--color-muted);
  }
  .service__heading,
  .service__body {
    min-width: 0;
  }
  .service__tag {
    margin-bottom: var(--space-4);
    color: var(--color-lime);
    overflow-wrap: anywhere;
  }
  .service__body {
    grid-column: 2;
  }
  .service__body > p {
    max-width: 37rem;
    color: var(--color-muted);
    font-size: var(--text-base);
    overflow-wrap: anywhere;
  }
  @media (max-width: 47.999rem) {
    .service:has(:global([data-examples-fallback][open])) .service__body {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 48rem) {
    .services__decoration {
      display: block;
    }
    .service {
      grid-template-columns: 3rem minmax(0, 1.1fr) minmax(0, 1fr);
      gap: var(--space-6);
      padding-block: var(--space-7);
    }
    .service__body {
      grid-column: auto;
    }
    .service__heading h3 {
      max-width: 20ch;
    }
  }
  @media (min-width: 64rem) {
    .service {
      padding-block: var(--space-7);
      column-gap: var(--space-7);
    }
  }
</style>
