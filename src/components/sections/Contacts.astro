---
import type { Contact } from '../../types/content';
import Container from '../ui/Container.astro';
import Star from '../brand/Star.astro';

interface Props {
  contacts: Contact[];
  isPreview: boolean;
}

const { contacts, isPreview } = Astro.props;
const kindLabels: Record<Contact['kind'], string> = {
  phone: 'Позвонить',
  email: 'Написать на почту',
  messenger: 'Написать в мессенджер',
};
---

<section id="contacts" class="contacts section" aria-labelledby="contacts-title">
  <Container>
    <div class="contacts__topline">
      <p class="eyebrow">На связи</p>
      <span aria-hidden="true" class="contacts__small-mark">
        ↗
      </span>
    </div>
    <div class="contacts__layout">
      <div class="contacts__intro">
        <h2 id="contacts-title">
          Давайте
          <br />
          выйдем <span>в эфир.</span>
        </h2>
        <p class="contacts__description">
          Расскажите о событии.
          <br />
          Обсудим формат и техническую сторону.
        </p>
      </div>
      <div class="contacts__channels">
        {contacts.length > 0 ? (
          <ul class="contacts__list">
            {contacts.map((contact) => (
              <li>
                <a href={contact.href} class="contacts__link">
                  <span class="contacts__channel-content">
                    <span class="contacts__channel-kind">{kindLabels[contact.kind]}</span>
                    <span class="contacts__channel-label">{contact.label}</span>
                  </span>
                  <svg
                    class="contacts__arrow"
                    viewBox="0 0 24 24"
                    width="26"
                    height="26"
                    aria-hidden="true"
                  >
                    <path
                      d="M5 19 19 5M5 5h14v14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          isPreview && (
            <div class="contacts__empty">
              <Star size={72} />
              <p>Контакты будут добавлены</p>
            </div>
          )
        )}
      </div>
    </div>
  </Container>
</section>

<style>
  .contacts {
    color: var(--color-on-violet);
    background: var(--color-violet);
  }

  .contacts__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-7);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid color-mix(in srgb, var(--color-on-violet) 35%, transparent);
  }

  .contacts__small-mark {
    font-family: var(--font-body);
    font-size: 2rem;
    line-height: 1;
  }

  .contacts__layout {
    display: grid;
    gap: var(--space-7);
  }

  .contacts__intro h2 {
    font-size: clamp(1.75rem, 3.3vw, 3rem);
    font-weight: 500;
    line-height: 1.3;
  }

  .contacts__intro h2 span {
    color: var(--color-lime);
  }

  .contacts__description {
    margin-top: var(--space-5);
    font-size: var(--text-base);
    line-height: 1.55;
  }

  .contacts__channels {
    align-self: end;
    min-width: 0;
  }

  .contacts__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contacts__list li {
    border-bottom: 1px solid color-mix(in srgb, var(--color-on-violet) 45%, transparent);
  }

  .contacts__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 5.5rem;
    padding-block: var(--space-5);
    text-decoration: none;
  }

  .contacts__channel-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }

  .contacts__channel-kind {
    font-size: var(--text-xs);
  }

  .contacts__channel-label {
    font-size: clamp(1.125rem, 1rem + 0.7vw, 1.625rem);
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .contacts__arrow {
    flex: 0 0 auto;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .contacts__empty {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding-block: var(--space-5);
    border-bottom: 1px solid color-mix(in srgb, var(--color-on-violet) 45%, transparent);
  }

  .contacts__empty > p {
    max-width: 13rem;
    font-size: var(--text-base);
  }

  @media (hover: hover) {
    .contacts__link:hover .contacts__channel-label {
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }

    .contacts__link:hover .contacts__arrow {
      transform: translate(2px, -2px);
    }
  }

  @media (min-width: 64rem) {
    .contacts__layout {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: var(--space-9);
    }

    .contacts__topline {
      margin-bottom: var(--space-8);
    }
  }
</style>
