---
import type { Contact } from '../../types/content';
import Container from '../ui/Container.astro';
import ContactIntro from '../ui/ContactIntro.astro';
import ContactIcon from '../ui/ContactIcon.astro';

interface Props {
  contacts: Contact[];
  isPreview: boolean;
}

const { contacts, isPreview } = Astro.props;
const kindLabels: Record<Contact['kind'], string> = {
  phone: 'Позвонить',
  email: 'Написать на почту',
  messenger: 'Написать в Telegram',
};
---

<section id="contacts" class="contacts section section-surface" aria-labelledby="contacts-title">
  <Container>
    <div class="contacts__layout">
      <div class="contacts__intro">
        <ContactIntro id="contacts-title" />
      </div>
      <div class="contacts__channels">
        {contacts.length > 0 ? (
          <ul class="contacts__list">
            {contacts.map((contact) => (
              <li>
                <a href={contact.href} class="contacts__link">
                  <span class="contacts__icon"><ContactIcon kind={contact.kind} family="reference" /></span>
                  <span class="contacts__channel-content">
                    <span class="sr-only">{kindLabels[contact.kind]}</span>
                    <span class="contacts__channel-label">{contact.label}</span>
                  </span>
                  <svg
                    class="contacts__arrow"
                    viewBox="0 0 24 24"
                    width="26"
                    height="26"
                    aria-hidden="true"
                  >
                    <path
                      d="M5 19 19 5M5 5h14v14"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.5"
                    />
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          isPreview && (
            <ul class="contacts__list" aria-label="Контакты — временные заглушки">
              {[
                { kind: 'Telegram', label: '@username' },
                { kind: 'Телефон', label: '+7 (XXX) XXX-XX-XX' },
                { kind: 'Почта', label: 'name@example.com' },
              ].map((item) => (
                <li>
                  <div class="contacts__link contacts__placeholder">
                    <span class="contacts__channel-content">
                      <span class="sr-only">{item.kind}</span>
                      <span class="contacts__channel-label">{item.label}</span>
                    </span>
                  </div>
                </li>
              ))}
            </ul>
          )
        )}
      </div>
    </div>
  </Container>
</section>

<style>
  .contacts {
    padding-block: clamp(2.5rem, 4vw, 4rem);
    color: var(--color-text);
  }
  .contacts__layout {
    display: grid;
    gap: var(--space-6);
  }
  .contacts__intro {
    min-width: 0;
  }
  .contacts__channels {
    align-self: center;
    min-width: 0;
  }
  .contacts__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .contacts__list li {
    border-bottom: 1px solid var(--color-border);
  }
  .contacts__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 4rem;
    padding-block: var(--space-4);
    text-decoration: none;
  }
  .contacts__icon { display: none; }
  .contacts__channel-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    min-width: 0;
  }
  .contacts__channel-label {
    font-size: clamp(1.125rem, 1rem + 0.4vw, 1.375rem);
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }
  .contacts__arrow {
    color: var(--color-lime);
    flex: 0 0 auto;
    transition: transform var(--duration-base) var(--ease-out);
  }
  @media (max-width: 47.999rem) {
    .contacts { padding-block: 1.75rem; }
    .contacts__layout { gap: 1rem; }
    .contacts__list { border-top: 1px solid var(--color-border); }
    .contacts__link { min-height: 3.125rem; padding-block: 0.125rem; justify-content: flex-start; gap: 0.625rem; }
    .contacts__icon { display: block; flex: 0 0 1.0625rem; width: 1.0625rem; height: 1.0625rem; color: var(--color-lime); }
    .contacts__channel-label { font-size: 1.125rem; font-weight: 500; font-variant-numeric: tabular-nums; }
    .contacts__arrow { margin-left: auto; width: 1rem; height: 1rem; color: var(--color-muted); }
  }
  @media (hover: hover) {
    a.contacts__link:hover .contacts__channel-label {
      text-decoration: underline;
      text-underline-offset: 0.22em;
    }
    a.contacts__link:hover .contacts__arrow {
      transform: translate(2px, -2px);
    }
  }
  @media (min-width: 64rem) {
    .contacts__layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      gap: var(--section-column-gap);
    }
  }
</style>
