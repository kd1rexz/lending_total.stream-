---
import Container from '../ui/Container.astro';
import { Image } from 'astro:assets';
import type { TrustItem } from '../../types/content';
interface Props {
  items: TrustItem[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="trust" id="clients" aria-labelledby="trust-title">
    <Container>
      <div class="trust__layout">
        <h2 id="trust-title">Нам доверяют</h2>
        <ul class="trust__logos" role="list">
          {items.map((item) => (
            <li data-client={item.name} style={`--logo-width: ${item.displayWidth}px`}>
              <Image
                src={item.logo}
                alt={item.name}
                width={Math.round(item.displayWidth * 2)}
                loading="lazy"
                decoding="async"
              />
            </li>
          ))}
        </ul>
      </div>
    </Container>
  </section>
)}

<style>
  .trust {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .trust__layout {
    display: grid;
    gap: var(--space-7);
  }
  .trust h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
  }
  .trust__logos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust__logos li {
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 5.5rem;
  }
  .trust__logos img {
    width: min(var(--logo-width), 85%);
    height: 3rem;
    object-fit: contain;
    filter: grayscale(1) brightness(0) invert(1);
    opacity: 0.8;
  }
  @media (min-width: 48rem) {
    .trust__logos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: var(--space-6);
    }
    .trust__logos li {
      min-height: 6rem;
    }
  }
</style>
