---
import Container from '../ui/Container.astro';
import type { TrustItem } from '../../types/content';
interface Props {
  items: TrustItem[];
}
const { items } = Astro.props;
---

{items.length > 0 && (
  <section class="trust" aria-labelledby="trust-title">
    <Container>
      <div class="trust__layout">
        <h2 class="eyebrow" id="trust-title">
          С нами работают
        </h2>
        <ul class="trust__names" role="list">
          {items.map((item) => (
            <li>{item.name}</li>
          ))}
        </ul>
      </div>
    </Container>
  </section>
)}

<style>
  .trust {
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }
  .trust__layout {
    display: grid;
    gap: var(--space-6);
  }
  .trust h2 {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1.5;
  }
  .trust__names {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .trust__names li {
    min-width: 0;
    max-width: 100%;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 400;
    overflow-wrap: anywhere;
  }
  @media (min-width: 64rem) {
    .trust__layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      gap: var(--space-7);
      align-items: center;
    }
  }
</style>
