---
import type { NavItem } from '../../types/content';
import Logo from '../brand/Logo.astro';
import Container from '../ui/Container.astro';

interface Props {
  navigation: NavItem[];
}

const { navigation } = Astro.props;
---

<header class="site-header" data-site-header>
  <Container class="site-header__inner">
    <a class="site-header__home" href="#top" aria-label="Total Stream — к началу страницы">
      <Logo />
    </a>
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-menu-toggle
      hidden
    >
      <span data-menu-label>Меню</span>
      <span class="site-header__toggle-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
    <nav
      id="site-navigation"
      class="site-header__navigation"
      aria-label="Основная навигация"
      data-navigation
    >
      <ul class="site-header__links">
        {navigation.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </Container>
</header>

<script>
  import { initNavigation } from '../../scripts/navigation';
  import '../../scripts/header-scroll';
  initNavigation();
  document.addEventListener('astro:page-load', initNavigation);
</script>

<style>
  .site-header {
    --header-shade: rgb(20 21 23 / 94%);
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    background: transparent;
  }
  .site-header[data-scroll-header] {
    position: fixed;
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1), visibility 300ms;
    will-change: transform;
  }
  .site-header[data-header-hidden] {
    transform: translateY(-105%);
    visibility: hidden;
    pointer-events: none;
  }
  .site-header[data-over-content] {
    background: var(--header-shade);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .site-header :global(.site-header__inner) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--header-height);
    padding-block: var(--space-2);
  }

  .site-header__home {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    min-height: 2.75rem;
    border-radius: 0.2rem;
    text-decoration: none;
  }

  .site-header__home :global(.brand-logo) {
    gap: var(--space-4);
  }

  .site-header__home :global(.brand-logo__mark) {
    width: 56px;
    height: 56px;
  }

  .site-header__home :global(.brand-logo__wordmark) {
    font-size: 1.125rem;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-4);
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    line-height: 1;
  }

  .site-header__toggle-icon {
    position: relative;
    display: block;
    width: 1.125rem;
    height: 0.75rem;
  }

  .site-header__toggle-icon span {
    position: absolute;
    inset-inline: 0;
    height: 1px;
    background: currentColor;
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header__toggle-icon span:first-child {
    top: 0.125rem;
  }
  .site-header__toggle-icon span:last-child {
    bottom: 0.125rem;
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon span:first-child {
    transform: translateY(0.21875rem) rotate(45deg);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon span:last-child {
    transform: translateY(-0.21875rem) rotate(-45deg);
  }

  .site-header__navigation {
    flex-basis: 100%;
    order: 3;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .site-header__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__links a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transform-origin: center;
    transition:
      color 220ms ease,
      transform 280ms cubic-bezier(0.23, 1, 0.32, 1),
      scale 320ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .site-header__links a { position: relative; isolation: isolate; }
  .site-header__links a::after { content: ''; position: absolute; bottom: 0.25rem; left: 0; right: 0; height: 2px; background: var(--color-violet-text); transform: scaleX(0); transform-origin: left; transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1); pointer-events: none; }
  .site-header__links a:focus-visible { transform: translateY(-2px); }
  .site-header__links a:focus-visible::after { transform: scaleX(1); }
  .site-header__links a:active { scale: 0.97; }
  @media (hover: hover) and (pointer: fine) {
    .site-header__links a:hover { transform: translateY(-2px); }
    .site-header__links a:hover::after { transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header[data-scroll-header] { transition: none; }
    .site-header__toggle-icon span { transition: none; }
    .site-header__links a::before, .site-header__links a::after { transition: none !important; }
    .site-header__links a {
      transition: none;
      transform: none !important;
      scale: 1 !important;
    }
  }

  @media (max-width: 63.999rem) {
    .site-header[data-navigation-initialized] :global(.site-header__inner) { position: relative; flex-wrap: nowrap; }
    .site-header[data-navigation-initialized] .site-header__navigation {
      position: absolute; top: calc(50% + 1.375rem + 0.5rem); right: 0;
      width: min(13rem, 100%); margin: 0; padding: 0.5rem;
      border: 1px solid var(--color-border-strong); border-radius: 1rem;
      background: rgb(20 21 23 / 16%); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
      transform-origin: top right;
    }
    .site-header[data-navigation-initialized] .site-header__links { grid-template-columns: minmax(0, 1fr); gap: 0.125rem; }
    .site-header[data-over-content][data-navigation-initialized] .site-header__navigation {
      background: var(--header-shade);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
    }
    .site-header[data-navigation-initialized] .site-header__links a { min-height: 2.875rem; padding: 0.5rem 0.75rem; font-size: 1rem; border-radius: 0.5rem; }
    .site-header__links a::after { display: none; }
    .site-header__links a:hover, .site-header__links a:focus-visible { transform: none; }
  }
  @media (hover: none), (pointer: coarse) {
    .site-header__links a::after { display: none; }
    .site-header__links a:hover, .site-header__links a:focus-visible { transform: none; }
  }
  @media (max-width: 22.499rem) {
    .site-header__home :global(.brand-logo) {
      gap: var(--space-2);
    }
    .site-header__home :global(.brand-logo__wordmark) {
      font-size: 1rem;
    }
    .site-header :global(.site-header__inner) {
      column-gap: var(--space-2);
    }
  }

  @media (min-width: 64rem) {
    .site-header__home :global(.brand-logo__mark) {
      width: 72px;
      height: 72px;
    }
    .site-header__home :global(.brand-logo__wordmark) {
      font-size: 1.375rem;
    }
    .site-header :global(.site-header__inner) {
      flex-wrap: nowrap;
      gap: var(--space-6);
      padding-block: var(--space-3);
    }

    .site-header__navigation {
      flex: 1 1 auto;
      min-width: 0;
      order: 0;
      margin-left: auto;
      padding: 0;
      border: 0;
    }

    .site-header__links {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-end;
      gap: 0 clamp(1.25rem, 2.3vw, 2.5rem);
    }

    .site-header__links a {
      font-size: var(--text-sm);
    }
  }
</style>
