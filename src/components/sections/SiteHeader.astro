---
import type { NavItem } from '../../types/content';
import Logo from '../brand/Logo.astro';
import Container from '../ui/Container.astro';

interface Props {
  navigation: NavItem[];
}

const { navigation } = Astro.props;
---

<header class="site-header" data-site-header>
  <Container class="site-header__inner">
    <a class="site-header__home" href="#top" aria-label="Total Stream — к началу страницы">
      <Logo />
    </a>
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
      data-menu-toggle
      hidden
    >
      <span data-menu-label>Меню</span>
      <span class="site-header__toggle-icon" aria-hidden="true">
        <span></span>
        <span></span>
      </span>
    </button>
    <nav
      id="site-navigation"
      class="site-header__navigation"
      aria-label="Основная навигация"
      data-navigation
    >
      <ul class="site-header__links">
        {navigation.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href="#contacts" class="site-header__contact">
      <span class="site-header__contact-dot" aria-hidden="true"></span>
      Обсудить проект
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
        <path d="M5 19 19 5M5 5h14v14" fill="none" stroke="currentColor" stroke-width="1.7" />
      </svg>
    </a>
  </Container>
</header>

<script>
  import { initNavigation } from '../../scripts/navigation';
  initNavigation();
  document.addEventListener('astro:page-load', initNavigation);
</script>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header :global(.site-header__inner) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--header-height);
    padding-block: var(--space-5);
  }

  .site-header__home {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    min-height: 2.75rem;
    border-radius: 0.2rem;
    text-decoration: none;
  }

  .site-header__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    padding: var(--space-3) var(--space-4);
    background: transparent;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    line-height: 1;
  }

  .site-header__toggle-icon {
    position: relative;
    display: block;
    width: 1.125rem;
    height: 0.75rem;
  }

  .site-header__toggle-icon span {
    position: absolute;
    inset-inline: 0;
    height: 1px;
    background: currentColor;
    transition: transform var(--duration-fast) ease;
  }

  .site-header__toggle-icon span:first-child {
    top: 0.125rem;
  }
  .site-header__toggle-icon span:last-child {
    bottom: 0.125rem;
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon span:first-child {
    transform: translateY(0.21875rem) rotate(45deg);
  }
  .site-header__toggle[aria-expanded='true'] .site-header__toggle-icon span:last-child {
    transform: translateY(-0.21875rem) rotate(-45deg);
  }

  .site-header__navigation {
    flex-basis: 100%;
    order: 3;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .site-header__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__links a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--duration-fast) ease;
  }

  .site-header__contact {
    display: none;
  }

  @media (hover: hover) {
    .site-header__links a:hover,
    .site-header__contact:hover {
      color: var(--color-lime);
    }
  }

  @media (min-width: 64rem) {
    .site-header :global(.site-header__inner) {
      flex-wrap: nowrap;
      gap: var(--space-6);
    }

    .site-header__navigation {
      flex-basis: auto;
      order: 0;
      margin-left: auto;
      padding: 0;
      border: 0;
    }

    .site-header__links {
      display: flex;
      gap: clamp(1.25rem, 2.3vw, 2.5rem);
    }

    .site-header__links a {
      font-size: var(--text-xs);
    }

    .site-header__contact {
      display: inline-flex;
      flex-shrink: 0;
      align-items: center;
      gap: var(--space-3);
      min-height: 2.75rem;
      padding: var(--space-3) var(--space-4);
      border: 1px solid var(--color-border-strong);
      border-radius: var(--radius-pill);
      font-size: var(--text-xs);
      text-decoration: none;
      transition: color var(--duration-fast) ease;
    }

    .site-header__contact-dot {
      width: 0.375rem;
      height: 0.375rem;
      border-radius: 50%;
      background: var(--color-lime);
    }
  }
</style>
