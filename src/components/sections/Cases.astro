---
import { Image } from 'astro:assets';
import Container from '../ui/Container.astro';
import previewPhoto from '../../assets/images/brand-reference-hero.jpg';
import type { CaseStudy } from '../../types/content';
interface Props {
  items: CaseStudy[];
  isPreview: boolean;
}
const { items, isPreview } = Astro.props;
const isDraft = items.length === 0;
function getExcerpt(description: string) {
  const first = description.split('\n', 1)[0].trim();
  const opening = first.match(/^.{1,100}?[.!?…](?=\s|$)/u)?.[0];
  if (opening) return opening === description.trim() ? '' : opening;
  if (first.length <= 80) return first === description.trim() ? '' : first;
  const cut = first.lastIndexOf(' ', 80);
  return first.slice(0, cut > 0 ? cut : 80).trimEnd() + '…';
}
const sourceSlides = items.length ? items.map(item => ({
  id: item.id, title: item.title, description: item.solution || item.task,
  image: item.cover, alt: item.coverAlt,
})) : isPreview ? Array.from({ length: 3 }, (_, index) => ({
  id: `draft-${index + 1}`, title: `Название проекта ${index + 1}`,
  description: 'Здесь будет описание того, что команда Total Stream сделала для заказчика: какой была задача, как организовали съёмку и трансляцию, какие технические решения использовали.\n\nВо второй части можно рассказать об особенностях площадки и результате проекта. Реальные название, фотографию и текст добавим после подготовки материалов.',
  image: previewPhoto, alt: 'Временное изображение для макета кейса',
})) : [];
const slides = sourceSlides.map(slide => ({ ...slide, excerpt: getExcerpt(slide.description) }));
---

{slides.length > 0 && (
  <section class="section section-surface cases" id="cases" aria-labelledby="cases-title" data-case-carousel>
    <Container>
      <div class="cases__heading">
        <h2 id="cases-title">События в деталях</h2>
      </div>
      <div class="cases__stage">
      <div class="cases__track" data-case-track tabindex="0" role="region" aria-label="Кейсы Total Stream — листайте проекты">
        {slides.map((slide, index) => (
          <article class="case-slide" data-case-slide role="group" aria-label={`Проект ${index + 1} из ${slides.length}`}>
            <div class="case-slide__visual">
              <div class="case-slide__image" data-cover={isDraft ? undefined : slide.id} style={isDraft ? `--photo-position: ${index * 50}% ${index * 50}%` : undefined}>
                <Image src={slide.image} alt={slide.alt} widths={[480, 800, 1200]} sizes="(min-width:768px) 42vw, 100vw" loading="lazy" format="webp" draggable="false" />
              </div>
            </div>
            <div class="case-slide__caption">
              <h3>{slide.title}</h3>
              <div class="case-slide__description">
                <div class="case-slide__story" id={`case-story-${slide.id}`}>{slide.description.split(/\n+/).map(paragraph => <p>{paragraph}</p>)}</div>
                {slide.excerpt && <>
                  <span class="case-slide__excerpt">{slide.excerpt}</span>
                  <button class="case-slide__more" type="button" data-case-more aria-expanded="false" aria-controls={`case-story-${slide.id}`} hidden>Ещё</button>
                </>}
              </div>
            </div>
          </article>
        ))}
      </div>
      {slides.length > 1 && (
        <div class="cases__controls" data-case-controls hidden>
          <button type="button" data-case-prev aria-label="Предыдущий кейс">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m14 6-6 6 6 6" /></svg>
          </button>
          <span class="cases__count" data-case-count aria-live="polite" aria-atomic="true">1 / {slides.length}</span>
          <button type="button" data-case-next aria-label="Следующий кейс">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m10 6 6 6-6 6" /></svg>
          </button>
        </div>
      )}
      </div>
    </Container>
  </section>
)}
<script>
  import '../../scripts/case-carousel';
</script>
<style>
  .cases { padding-block: clamp(3.5rem, 6vw, 5rem); }
  .cases__heading { margin-bottom: 2.5rem; }
  .cases__heading h2 { font-size: var(--text-h2); }
  .cases__stage { --case-padding: clamp(2rem, 3vw, 2.5rem); --case-gap: clamp(2rem, 4vw, 3rem); position: relative; }
  .cases__track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; border-radius: 1.5rem; }
  .cases__track[data-case-enhanced] { display: grid; overflow: hidden; scroll-snap-type: none; touch-action: pan-y pinch-zoom; border: 1px solid var(--color-border-strong); background: var(--color-bg); }
  .cases__track[data-case-enhanced] .case-slide { grid-area: 1 / 1; visibility: hidden; pointer-events: none; border: 0; background: transparent; }
  .cases__track[data-case-enhanced] .case-slide[data-active] { visibility: visible; pointer-events: auto; }
  .cases__track::-webkit-scrollbar { display: none; }
  .case-slide { position: relative; flex: 0 0 100%; min-width: 0; display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.15fr); align-content: start; align-items: stretch; gap: var(--case-gap); padding: var(--case-padding); border: 1px solid var(--color-border-strong); border-radius: 1.5rem; background: var(--color-bg); scroll-snap-align: start; scroll-snap-stop: always; }
  .case-slide__visual { display: flex; min-width: 0; }
  .case-slide__image { position: relative; overflow: hidden; flex: 1; min-width: 0; min-height: clamp(19rem, 27vw, 23rem); background: var(--color-surface); user-select: none; }
  .case-slide__image[data-cover="mice"] { --photo-position: 50% 37%; --photo-grade: brightness(1.055) saturate(.95); }
  .case-slide__image[data-cover="dobrofest"] { --photo-position: 47% 56%; --photo-grade: brightness(1.06) contrast(.97) saturate(.89); }
  .case-slide__image[data-cover="student"] { --photo-position: 70% 41%; --photo-grade: saturate(.94); }
  .case-slide__image[data-cover="student"] :global(img) { scale: 1.15; }
  /* Photos are presentation content: the wrapper, rather than the bitmap, receives pointer hits. */
  .case-slide__image :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; min-height: 0; object-fit: cover; object-position: var(--photo-position, center); pointer-events: none; user-select: none; -webkit-user-drag: none; }
  .case-slide__image[data-cover] :global(img) { filter: var(--photo-grade, none); transform-origin: var(--photo-position, center); }
  @media (prefers-reduced-motion: no-preference) {
    .case-slide[data-active] .case-slide__image[data-cover] :global(img) {
      animation: case-push-in 4.5s ease-in-out both;
      animation-play-state: var(--cover-motion, paused);
    }
    .cases__track[data-in-view] { --cover-motion: running; }
  }
  @keyframes case-push-in { from { transform: scale(1); } to { transform: scale(1.035); } }
  .case-slide__image::before, .case-slide__image::after { content: ''; position: absolute; z-index: 1; width: 2rem; height: 2rem; pointer-events: none; }
  .case-slide__image::before { top: 0; left: 0; border-top: 2px solid var(--color-lime); border-left: 2px solid var(--color-lime); }
  .case-slide__image::after { bottom: 0; right: 0; border-bottom: 2px solid var(--color-lime); border-right: 2px solid var(--color-lime); }
  .case-slide__caption { min-width: 0; padding-top: 1rem; padding-bottom: 5rem; }
  .case-slide__caption h3 { font-size: clamp(1.375rem, 2vw, 1.75rem); margin-bottom: 1.25rem; }
  .case-slide__description { max-width: 63ch; min-width: 0; }
  .case-slide__description p { font-size: 1.0625rem; color: var(--color-muted); line-height: 1.65; }
  .case-slide__description p + p { margin-top: 1rem; }
  .case-slide__excerpt, .case-slide__more { display: none; }
  .cases__controls { position: absolute; z-index: 3; bottom: calc(var(--case-padding) + 1px); right: calc(var(--case-padding) + 1px); width: calc((100% - 2px - 2 * var(--case-padding) - var(--case-gap)) * 1.15 / 2.15); display: flex; justify-content: flex-start; align-items: center; gap: 0.75rem; }
  .cases__controls button { display: grid; place-items: center; width: 48px; height: 48px; padding: 0; color: var(--color-text); background: var(--color-surface); border: 0; border-radius: 50%; transition: background-color 180ms ease, color 180ms ease, opacity 180ms ease, scale 320ms cubic-bezier(0.4, 0, 0.2, 1); }
  .cases__controls button:not(:disabled):active { scale: 0.97; }
  @media (prefers-reduced-motion: reduce) { .cases__controls button { transition: none; } .cases__controls button:not(:disabled):active { scale: 1; } }
  .cases__controls button:disabled { opacity: 0.3; cursor: default; }
  .cases__count { min-width: 3rem; text-align: center; color: var(--color-muted); font-size: 0.875rem; font-variant-numeric: tabular-nums; }
  @media (hover:hover) and (pointer:fine) { .cases__controls button:not(:disabled):hover { background: var(--color-violet); color: white; } }
  @media (max-width:63.999rem), (hover:none), (pointer:coarse) {
    .cases__controls button:not(:disabled):active, .cases__controls button:not(:disabled)[data-pressed] { background: var(--color-violet); color: white; }
  }
  @media (max-width:47.999rem) {
    .cases__stage { --case-padding: 1.5rem; --case-gap: 1.5rem; }
    .cases__track[data-case-enhanced] { position: relative; }
    .cases__track[data-case-enhanced] .case-slide[aria-hidden="true"] { position: absolute; inset: 0; }
    .cases__heading { margin-bottom: 2rem; }
    .case-slide { grid-template-columns: minmax(0,1fr); gap: var(--case-gap); padding: var(--case-padding); }
    .case-slide__caption { padding-top: 0; padding-bottom: 4rem; }
    .case-slide__caption h3 { font-size: 1.5rem; }
    .case-slide__description p { font-size: 1rem; }
    .case-slide__description[data-folded] .case-slide__story { display: none; }
    .case-slide__description[data-folded] .case-slide__excerpt { display: inline; color: var(--color-muted); font-size: 1rem; line-height: 1.65; }
    .case-slide__more:not([hidden]) {
      position: relative; display: inline-block; min-width: 44px; padding: 0; border: 0;
      background: transparent; color: var(--color-muted); font: 400 0.875rem/1.4 var(--font-body); text-align: start;
      text-decoration: underline; text-decoration-color: color-mix(in srgb, currentColor 45%, transparent); text-underline-offset: 0.16em;
    }
    .case-slide__more::after { content: ''; position: absolute; inset: 50% 0 auto; height: 44px; transform: translateY(-50%); }
    .case-slide__description[data-folded] .case-slide__more { margin-inline-start: 0.25rem; }
    .case-slide__description:not([data-folded]) .case-slide__more { margin-top: 0.625rem; }
    .case-slide__image { min-height: 0; height: clamp(12rem, 56vw, 18rem); }
    .cases__controls { bottom: calc(var(--case-padding) + 1px); width: calc(100% - 2px - 2 * var(--case-padding)); }
  }
</style>
