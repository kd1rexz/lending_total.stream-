---
import Container from '../ui/Container.astro';
import Logo from '../brand/Logo.astro';
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__brand">
      <a class="site-footer__home" href="#top" aria-label="Total Stream — к началу страницы"><Logo /></a>
    </div>
    <div class="site-footer__bottom">
      <p>© {year} Total Stream</p>
      <p>Видеотрансляции под ключ</p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-6) var(--space-5);
    background: var(--color-bg);
  }
  .site-footer__brand {
    padding-bottom: var(--space-6);
  }
  .site-footer__home { display: inline-flex; align-items: center; max-width: 100%; min-height: 2.75rem; text-decoration: none; }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
</style>
