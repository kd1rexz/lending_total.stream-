---
import Container from '../ui/Container.astro';
import Logo from '../brand/Logo.astro';
import type { SiteSettings } from '../../types/content';
interface Props { requisites?: SiteSettings['requisites']; }
const { requisites } = Astro.props;
const year = new Date().getUTCFullYear();
---

<footer class="site-footer">
  <Container>
    <div class="site-footer__brand">
      <a class="site-footer__home" href="#top" aria-label="Total Stream — к началу страницы"><Logo /></a>
      {requisites && (
        <section id="requisites" class="site-footer__requisites" aria-label="Реквизиты исполнителя">
          <p class="site-footer__owner">{requisites.name}</p>
          <p>ИНН {requisites.inn}</p>
          <p>ОГРНИП {requisites.ogrnip}</p>
        </section>
      )}
    </div>
    <div class="site-footer__bottom">
      <p>© {year} Total Stream</p>
      <p>Видеотрансляции под ключ</p>
    </div>
  </Container>
</footer>

<style>
  .site-footer {
    padding-block: var(--space-6) var(--space-5);
    background: var(--color-bg);
  }
  .site-footer__brand {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem clamp(1.5rem, 5vw, 5rem);
    padding-bottom: var(--space-5);
  }
  .site-footer__home { display: inline-flex; align-items: center; max-width: 100%; min-height: 2.75rem; text-decoration: none; }
  .site-footer__owner { grid-column: 1 / -1; }
  .site-footer__requisites {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.35rem 2rem;
    justify-self: end; min-width: 0; max-width: 36rem; color: var(--color-muted);
    overflow-wrap: anywhere;
    font-size: 0.75rem; line-height: 1.6;
  }
  @media (max-width: 47.999rem) {
    .site-footer__brand { grid-template-columns: minmax(0, 1fr); justify-items: start; row-gap: 1rem; padding-bottom: 1rem; }
    .site-footer__requisites {
      grid-template-columns: minmax(0, 1fr); justify-self: stretch; gap: 0.125rem;
      font-size: 0.8125rem; line-height: 1.5; font-variant-numeric: tabular-nums;
    }
    .site-footer__owner { margin-bottom: 0.25rem; font-size: 0.9375rem; color: var(--color-text); }
    .site-footer__home :global(.brand-logo) { gap: 0.5rem; }
    .site-footer__home :global(.brand-logo__mark) { width: 40px; height: 40px; }
    .site-footer__home :global(.brand-logo__wordmark) { font-size: 0.8125rem; }
  }
  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3) var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
  @media (max-width: 47.999rem) {
    .site-footer__bottom { gap: 0.25rem 1rem; padding-top: 0.875rem; font-size: 0.8125rem; }
  }
</style>
