---
interface Props {
  id: string;
  preview?: boolean;
}
const { id, preview = false } = Astro.props;
---

<h2 id={id} class:list={['contact-title', { 'preview-title': preview }]}>
  <span class="wide">Давайте<br />выйдем <span class="accent">в эфир</span></span>
  <span class="narrow">Обсудим <span class="accent">трансляцию</span></span>
</h2>
<p class={preview ? 'lead' : 'contacts__description'}>
  <span class="wide">Расскажите о событии.<br />Обсудим формат и техническую сторону.</span>
  <span class="narrow">Расскажите, где и когда пройдёт ваше событие. Подберём формат эфира.</span>
</p>

<style>
  .contact-title { font-size: clamp(1.5rem, 2.5vw, 2.25rem); line-height: 1.3; }
  .preview-title { font-size: clamp(2rem, 3vw, 2.75rem); line-height: 1.15; font-weight: 500; letter-spacing: -0.045em; text-wrap: balance; }
  .accent { color: var(--color-lime); }
  .preview-title .accent { color: var(--color-violet-text); }
  .lead { margin-top: 1.5rem; font-size: 1.125rem; line-height: 1.6; color: var(--color-muted); }
  .contacts__description { margin-top: var(--space-4); font-size: var(--text-base); line-height: 1.55; }
  .narrow { display: none; }
  @media (max-width: 47.999rem) {
    .wide { display: none; }
    .narrow { display: inline; }
    .contact-title { font-size: clamp(1.875rem, 7.8vw, 2.5rem); font-weight: 500; line-height: 1.15; letter-spacing: -0.035em; }
    .contact-title .accent { color: var(--color-violet-text); }
    .lead, .contacts__description { margin-top: 0.625rem; max-width: 38ch; color: var(--color-muted); font: 400 1rem/1.5 var(--font-body); }
  }
</style>
