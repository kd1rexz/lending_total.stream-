---
import ServiceProjects from './ServiceProjects.astro';
import type { ServiceWithExamples } from '../../types/content';

interface Props {
  service: ServiceWithExamples;
  instance?: string;
  presentation?: 'button' | 'title';
}
const { service, instance, presentation = 'button' } = Astro.props;
const dialogId = `examples-${instance ? `${instance}-` : ''}${service.id}`;
const triggerLabel = presentation === 'title' ? service.title : 'Смотреть примеры';
const titleId = `${dialogId}-title`;
---

<div
  class:list={['examples', { 'examples--title': presentation === 'title' }]}
  data-service-examples
>
  <button
    class="examples__trigger"
    type="button"
    aria-label={`Смотреть примеры: ${service.title}`}
    aria-haspopup="dialog"
    aria-controls={dialogId}
    data-examples-open
    hidden
  >
    <span>{triggerLabel}</span>
  </button>
  <details data-examples-fallback>
    <summary class="examples__trigger" aria-label={`Смотреть примеры: ${service.title}`}>
      <span>{triggerLabel}</span>
    </summary>
    <div class="examples__content" data-examples-content>
      <div class="examples__intro">
        <h3 id={titleId}>{service.title}</h3>
      </div>
      <ServiceProjects service={service} />
    </div>
  </details>
  <dialog class="examples__dialog" id={dialogId} aria-labelledby={titleId} data-examples-dialog>
    <div class="examples__toolbar">
      <span class="eyebrow">Total Stream / проекты</span>
      <button
        class="examples__close"
        type="button"
        aria-label="Закрыть примеры"
        data-examples-close
      >
        <svg width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M6 18 18 6" fill="none" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </button>
    </div>
  </dialog>
</div>

<script>
  import '../../scripts/service-examples';
</script>

<style>
  .examples {
    margin-top: var(--space-5);
  }
  .examples__trigger {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    max-width: 100%;
    padding: var(--space-3) var(--space-5);
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-button-gray);
    color: var(--color-bg);
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: center;
    list-style: none;
    transition: color var(--duration-base) ease;
  }
  .examples__trigger::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--color-text);
    transform: translateY(105%);
    transition: transform var(--duration-base) var(--ease-out);
  }
  .examples__trigger:focus-visible {
    color: var(--color-bg);
  }
  .examples__trigger:focus-visible::before {
    transform: translateY(0);
  }
  .examples__trigger::-webkit-details-marker {
    display: none;
  }
  .examples__trigger > span:first-child {
    overflow-wrap: anywhere;
  }
  .examples--title {
    margin-top: 0;
  }
  .examples--title > .examples__trigger,
  .examples--title > details > .examples__trigger {
    justify-content: flex-start;
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.025em;
    text-align: left;
  }
  .examples--title > .examples__trigger::before,
  .examples--title > details > .examples__trigger::before {
    display: none;
  }
  .examples--title > .examples__trigger:is(:hover, :focus-visible),
  .examples--title > details > .examples__trigger:is(:hover, :focus-visible) {
    color: var(--color-violet-text);
  }

  .examples__dialog {
    width: min(64rem, calc(100% - 2rem));
    max-width: none;
    max-height: calc(100vh - 2rem);
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 0;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-card);
    background: var(--color-bg);
    color: var(--color-text);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-gutter: stable;
  }
  .examples__dialog::backdrop {
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(6px);
  }
  .examples__toolbar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-muted);
  }
  .examples__close {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    color: var(--color-bg);
    background: var(--color-button-gray);
    transition:
      color var(--duration-fast) ease,
      background var(--duration-fast) ease;
  }
  .examples__content {
    padding: var(--page-gutter);
  }
  .examples__intro {
    margin-bottom: var(--space-7);
  }
  .examples__tag {
    color: var(--color-muted);
    margin-bottom: var(--space-5);
  }
  .examples__intro h3 {
    font-size: 1.5rem;
    max-width: 24ch;
  }
  .examples__description {
    color: var(--color-muted);
    max-width: 44rem;
    margin-top: var(--space-5);
    font-size: var(--text-base);
  }
  .examples__content :is(h4, p, dt, dd, a) {
    overflow-wrap: anywhere;
  }
  details > .examples__content {
    padding: var(--space-4);
    margin-top: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  details .example__body {
    padding: var(--space-4);
  }
  @media (hover: hover) {
    .examples__trigger:hover {
      color: var(--color-bg);
    }
    .examples__trigger:hover::before {
      transform: translateY(0);
    }
    .examples__close:hover {
      background: var(--color-text);
      color: var(--color-bg);
    }
  }
  @media (min-width: 48rem) {
    .examples__intro h3 {
      font-size: var(--text-h2);
    }
    .examples__dialog .examples__content {
      padding: var(--space-7);
    }
  }
</style>
