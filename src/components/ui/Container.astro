---
interface Props {
  as?: 'div' | 'section' | 'header' | 'footer' | 'nav';
  class?: string;
  id?: string;
}

const { as: Tag = 'div', class: className, id } = Astro.props;
---

<Tag class:list={['container', className]} id={id}>
  <slot />
</Tag>

<style>
  .container {
    width: min(calc(100% - var(--page-gutter) * 2), var(--container-max));
    margin-inline: auto;
  }
</style>
