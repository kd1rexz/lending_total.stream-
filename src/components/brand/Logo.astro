---
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo-variant-3.png';

interface Props {
  class?: string;
  compact?: boolean;
  dark?: boolean;
}

const { class: className, compact = false, dark = false } = Astro.props;
---

<span
  class:list={['brand-logo', { 'brand-logo--dark': dark }, className]}
  role="img"
  aria-label="Total Stream"
>
  <Image
    src={logo}
    width={48}
    height={48}
    widths={[48, 96, 144]}
    sizes="48px"
    format="webp"
    quality={100}
    alt=""
    aria-hidden="true"
    loading="eager"
    class="brand-logo__mark"
  />
  {!compact && (
    <span class="brand-logo__wordmark" aria-hidden="true">
      TOTAL
      <br />
      STREAM
    </span>
  )}
</span>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    line-height: 0.98;
  }

  .brand-logo :global(.brand-logo__mark) {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    object-fit: contain;
  }

  .brand-logo__wordmark {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.045em;
  }

  .brand-logo--dark {
    color: var(--color-bg);
  }
</style>
