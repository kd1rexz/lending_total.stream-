---
import logo from '../../assets/brand/logo-source.png';

interface Props {
  class?: string;
  compact?: boolean;
  dark?: boolean;
}

const { class: className, compact = false, dark = false } = Astro.props;
---

<span
  class:list={['brand-logo', { 'brand-logo--dark': dark }, className]}
  role="img"
  aria-label="Total Stream"
>
  <span class="brand-logo__mark" aria-hidden="true">
    <img
      src={logo.src}
      width={logo.width}
      height={logo.height}
      alt=""
      loading="eager"
      class="brand-logo__source"
    />
  </span>
  {!compact && (
    <span class="brand-logo__wordmark" aria-hidden="true">
      TOTAL
      <br />
      STREAM
    </span>
  )}
</span>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    line-height: 0.98;
  }

  .brand-logo :global(.brand-logo__mark) {
    flex: 0 0 auto;
    width: 48px;
    height: 48px;
    position: relative;
    overflow: hidden;
  }

  /* Display the original PNG unchanged; frame out its transparent canvas in CSS.
     Source: 1672 × 941; visible bounds: x465–1221, y80–821. */
  .brand-logo__source {
    position: absolute;
    width: 221.164021%;
    max-width: none;
    height: auto;
    left: -61.507937%;
    top: -9.589947%;
  }

  .brand-logo__wordmark {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.045em;
  }

  .brand-logo--dark {
    color: var(--color-bg);
  }
</style>
