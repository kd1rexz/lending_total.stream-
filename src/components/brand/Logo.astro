---
interface Props {
  class?: string;
  compact?: boolean;
  dark?: boolean;
}

const { class: className, compact = false, dark = false } = Astro.props;
---

<span
  class:list={['brand-logo', { 'brand-logo--dark': dark }, className]}
  role="img"
  aria-label="Total Stream"
>
  <svg class="brand-logo__mark" width="46" height="46" viewBox="0 0 64 64" aria-hidden="true">
    <path class="brand-logo__ring" d="m32 3 25 14v30L32 61 7 47V17Z" fill="none" stroke-width="5" />
    <path d="m32 3 25 14-8 5-25-14ZM7 47l8-5 25 14-8 5Z" class="brand-logo__facet" />
    <path d="m21 15 30 17-30 17Z" class="brand-logo__play" />
    <path d="m29 26 11 6-11 6Z" class="brand-logo__cutout" />
  </svg>
  {!compact && (
    <span class="brand-logo__wordmark" aria-hidden="true">
      TOTAL
      <br />
      STREAM
    </span>
  )}
</span>

<style>
  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    line-height: 0.98;
  }

  .brand-logo__mark {
    flex: 0 0 auto;
    overflow: visible;
  }

  .brand-logo__ring {
    stroke: currentColor;
    opacity: 0.8;
  }

  .brand-logo__facet,
  .brand-logo__play {
    fill: var(--color-violet);
  }

  .brand-logo__cutout {
    fill: var(--color-text);
  }

  .brand-logo__wordmark {
    font-family: var(--font-body);
    font-size: 1.375rem;
    font-weight: 800;
    letter-spacing: -0.045em;
  }

  .brand-logo--dark {
    color: var(--color-bg);
  }
</style>
