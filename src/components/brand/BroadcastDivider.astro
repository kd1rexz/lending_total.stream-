---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const timecodes = ['00:00', '00:10', '00:20', '00:30'];
const cameras = ['CAM 01', 'CAM 02', 'CAM 03', 'CAM 01'];
// A fixed decorative waveform, not a live audio meter.
const waveform = Array.from({ length: 120 }, (_, index) => {
  const envelope = Math.abs(Math.sin(index * 0.19) * Math.cos(index * 0.43));
  return { x: index * 5 + 2, height: 1 + envelope * 10 };
});
---

<div class:list={['broadcast-divider', className]} aria-hidden="true">
  <div class="broadcast-divider__inner">
    <div class="broadcast-divider__endpoint">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
        <rect x="3" y="7" width="12" height="11" rx="2" />
        <path d="m15 11 6-3v9l-6-3M7 4h4" />
        <circle cx="7" cy="11" r="1" class="broadcast-divider__record" />
      </svg>
      <span>Съёмка</span>
    </div>

    <div class="broadcast-divider__timeline">
      <div class="broadcast-divider__ruler">
        {timecodes.map((timecode) => (
          <span>{timecode}</span>
        ))}
      </div>
      <div class="broadcast-divider__clips">
        {cameras.map((camera) => (
          <span>{camera}</span>
        ))}
      </div>
      <svg
        class="broadcast-divider__waveform"
        viewBox="0 0 600 12"
        preserveAspectRatio="none"
        width="600"
        height="12"
      >
        {waveform.map(({ x, height }) => (
          <path d={`M${x} ${(12 - height) / 2}v${height}`} />
        ))}
      </svg>
      <span class="broadcast-divider__playhead"></span>
    </div>

    <div class="broadcast-divider__endpoint broadcast-divider__endpoint--output">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
        <circle cx="12" cy="12" r="2" class="broadcast-divider__record" />
        <path d="M7.8 7.8a6 6 0 0 0 0 8.4m8.4-8.4a6 6 0 0 1 0 8.4M5 5a10 10 0 0 0 0 14M19 5a10 10 0 0 1 0 14" />
      </svg>
      <span>Эфир</span>
    </div>
  </div>
</div>

<style>
  .broadcast-divider {
    height: var(--hero-divider-height, 4.5rem);
    overflow: clip;
    border-block: 1px solid var(--color-border);
    background: var(--color-surface);
    pointer-events: none;
    user-select: none;
  }

  .broadcast-divider__inner {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    width: min(calc(100% - var(--page-gutter) * 2), var(--container-max));
    height: 100%;
    margin-inline: auto;
  }

  .broadcast-divider__endpoint {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .broadcast-divider__endpoint svg {
    flex: 0 0 auto;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .broadcast-divider__record,
  .broadcast-divider__endpoint--output {
    color: var(--color-lime);
  }

  .broadcast-divider__record {
    fill: currentColor;
    stroke: none;
  }

  .broadcast-divider__endpoint span {
    display: none;
  }

  .broadcast-divider__timeline {
    position: relative;
    display: grid;
    flex: 1;
    min-width: 0;
    gap: 3px;
    padding-block: 5px;
  }

  .broadcast-divider__ruler {
    display: flex;
    justify-content: space-between;
    height: 14px;
    color: var(--color-muted);
    background: repeating-linear-gradient(
        90deg,
        var(--color-border-strong) 0 1px,
        transparent 1px 12px
      )
      bottom / 100% 3px no-repeat;
    font-family: var(--font-mono);
    font-size: 8px;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .broadcast-divider__clips {
    display: grid;
    grid-template-columns: 1.15fr 1.6fr 1fr 1.25fr;
    gap: 3px;
  }

  .broadcast-divider__clips span {
    overflow: hidden;
    padding: 2px 5px;
    border-left: 2px solid var(--color-violet-text);
    border-radius: 1px;
    background: color-mix(in srgb, var(--color-violet) 38%, var(--color-surface));
    color: var(--color-violet-text);
    font-family: var(--font-mono);
    font-size: 8px;
    line-height: 1;
    white-space: nowrap;
  }

  .broadcast-divider__clips span:nth-child(2n) {
    background: color-mix(in srgb, var(--color-violet) 65%, var(--color-surface));
    color: var(--color-text);
  }

  .broadcast-divider__waveform {
    width: 100%;
    height: 9px;
    color: var(--color-lime);
    opacity: 0.7;
  }

  .broadcast-divider__waveform path {
    stroke: currentColor;
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .broadcast-divider__playhead {
    position: absolute;
    inset-block: 3px;
    left: 38%;
    width: 1px;
    background: var(--color-lime);
  }

  .broadcast-divider__playhead::before {
    position: absolute;
    top: 0;
    left: -3px;
    width: 7px;
    height: 5px;
    background: inherit;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    content: '';
  }

  @media (min-width: 48rem) {
    .broadcast-divider__endpoint span {
      display: inline;
    }

    .broadcast-divider__timeline {
      gap: 4px;
    }

    .broadcast-divider__ruler {
      height: 17px;
      font-size: 10px;
    }

    .broadcast-divider__clips span {
      padding: 3px 8px;
      font-size: 10px;
    }

    .broadcast-divider__waveform {
      height: 12px;
    }
  }
</style>
