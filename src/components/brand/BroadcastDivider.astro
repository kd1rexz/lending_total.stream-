---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['broadcast-divider', className]} aria-hidden="true"></div>

<style>
  .broadcast-divider {
    position: relative;
    width: min(calc(100% - var(--page-gutter) * 2), var(--container-max));
    height: 1rem;
    margin-inline: auto;
    overflow: clip;
    background: repeating-linear-gradient(
      135deg,
      color-mix(in srgb, var(--color-muted) 35%, var(--color-bg)) 0 18px,
      var(--color-bg) 18px 36px
    );
    pointer-events: none;
  }

  .broadcast-divider::before {
    position: absolute;
    inset: 0 auto 0 0;
    width: 24%;
    background: repeating-linear-gradient(
      135deg,
      var(--color-lime) 0 18px,
      var(--color-violet) 18px 36px
    );
    content: '';
  }

  @media (min-width: 48rem) {
    .broadcast-divider {
      height: 1.5rem;
    }
  }
</style>
