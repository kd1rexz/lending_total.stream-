---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class:list={['checker-pattern', className]} aria-hidden="true"></div>

<style>
  .checker-pattern {
    --checker-size: 2rem;
    width: 100%;
    height: calc(var(--checker-size) * 2);
    background: repeating-conic-gradient(var(--color-lime) 0% 25%, var(--color-violet) 0% 50%) 0 0 /
      calc(var(--checker-size) * 2) calc(var(--checker-size) * 2);
    pointer-events: none;
  }

  @media (min-width: 48rem) {
    .checker-pattern {
      --checker-size: 2.5rem;
    }
  }
</style>
