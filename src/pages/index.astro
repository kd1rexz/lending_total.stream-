---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import Hero from '../components/sections/Hero.astro';
import ServiceFlip from '../components/sections/ServiceFlip.astro';
import Cases from '../components/sections/Cases.astro';
import Reliability from '../components/sections/Reliability.astro';
import TeamVariants from '../components/sections/TeamVariants.astro';
import FAQ from '../components/sections/FAQ.astro';
import Trust from '../components/sections/Trust.astro';
import Reviews from '../components/sections/Reviews.astro';
import ContactVariants from '../components/sections/ContactVariants.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import { getPageContent } from '../lib/content';
import { resolveBuildContext } from '../lib/build-context.mjs';
import heroPoster from '../assets/images/hero-broadcast.jpg';

const { isPreview } = resolveBuildContext();
const content = await getPageContent();
---

<BaseLayout description={content.site.description} homepage>
  <SiteHeader navigation={content.navigation} />
  <main id="main">
    <Hero poster={heroPoster} />
    <ServiceFlip items={content.services} />
    <Cases items={content.cases} isPreview={isPreview} />
    <Trust items={content.clients} />
    <Reliability items={content.reliability} />
    <TeamVariants profile={content.team} />
    <Reviews items={content.reviews} />
    <FAQ items={content.faq} />
    <ContactVariants contacts={content.site.contacts} />
  </main>
  <SiteFooter requisites={content.site.requisites} />
</BaseLayout>
<script>
  import '../scripts/reveal';
  import '../scripts/press-feedback';
</script>
