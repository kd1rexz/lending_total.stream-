# Maps belong to http {}, not inside a server block.
map $status $ts_@@KEY@@_asset_cache {
    default "no-store";
    200 "public, max-age=31536000, immutable";
    304 "public, max-age=31536000, immutable";
}
map $status $ts_@@KEY@@_html_cache {
    default "no-store";
    200 "@@HTML_CACHE@@";
    304 "@@HTML_CACHE@@";
}
map $status $ts_@@KEY@@_public_cache {
    default "no-store";
    200 "@@PUBLIC_CACHE@@";
    304 "@@PUBLIC_CACHE@@";
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @@DOMAIN@@;
    ssl_certificate @@CERT@@;
    ssl_certificate_key @@CERT_KEY@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    root @@ROOT@@/current;
    index index.html;
    autoindex off;
    server_tokens off;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    gzip on;
    gzip_vary on;
    gzip_types text/css application/javascript text/javascript application/json application/xml image/svg+xml;
    # Do not persist visitor request details, including IPs in error messages.
    access_log off;
    error_log /dev/null crit;
    @@AUTH@@
    add_header X-Content-Type-Options nosniff always;
    @@ROBOTS@@
    add_header Cache-Control $ts_@@KEY@@_html_cache always;
    error_page 404 /404.html;

    location / {
        try_files $uri $uri/ =404;
    }
    # A prefix without ^~ preserves the hidden/source-file denials below.
    location /_astro/ {
        root @@ROOT@@/shared;
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        @@ROBOTS@@
        add_header Cache-Control $ts_@@KEY@@_asset_cache always;
    }
    location = /404.html {
        internal;
        add_header X-Content-Type-Options nosniff always;
        @@ROBOTS@@
        add_header Cache-Control no-store always;
    }
    location ~ ^/(favicon\.svg|robots\.txt|sitemap\.xml)$ {
        try_files $uri =404;
        add_header X-Content-Type-Options nosniff always;
        @@ROBOTS@@
        add_header Cache-Control $ts_@@KEY@@_public_cache always;
    }
    location ~ (^|/)\. { return 404; }
    location ~* \.(map|astro|ts|tsx|jsx|vue|svelte|md|toml|ya?ml|lock|sh|py)$ { return 404; }
}
@@ALIAS_SERVER@@
